#!/usr/bin/env bash
# TermGlow command-line interface.
set -euo pipefail

TERMGlow_ROOT="${TERMGlow_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
# shellcheck disable=SC1091
source "$TERMGlow_ROOT/lib/termglow.sh"

command_name="${1:-help}"
shift || true

case "$command_name" in
  list|ls)
    termglow_list_themes
    ;;
  preview|show)
    termglow_preview "${1:-$(termglow_current_theme)}"
    ;;
  apply|use|set)
    if [ -z "${1:-}" ]; then
      printf 'Usage: termglow apply <theme>\n' >&2
      exit 2
    fi
    termglow_set_theme "$1"
    ;;
  current|status)
    printf '%s\n' "$(termglow_current_theme)"
    ;;
  reset)
    termglow_reset
    ;;
  doctor|check)
    termglow_doctor
    ;;
  install)
    termglow_install
    ;;
  uninstall|remove)
    termglow_uninstall
    ;;
  version|-v|--version)
    printf 'TermGlow %s\n' "$TERMGlow_VERSION"
    ;;
  help|-h|--help)
    termglow_usage
    ;;
  *)
    printf 'TermGlow: unknown command "%s"\n\n' "$command_name" >&2
    termglow_usage >&2
    exit 2
    ;;
esac
